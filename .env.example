# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: sync slash commands to this server instantly while developing.
# Leave empty to sync globally (can take up to an hour to propagate).
GUILD_ID=

# Optional: DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO

# Optional: JSON file used to store events, attendance, and payments.
EVENTS_FILE=data/events.json

# Optional: timezone used when interpreting event dates and times.
TIMEZONE=Asia/Jakarta
